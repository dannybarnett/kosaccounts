# Kosaccounts Dropbox secrets. Install to /etc/kosaccounts.env, owner root, mode 600:
#   sudo install -o root -g root -m 600 systemd/kosaccounts.env.example /etc/kosaccounts.env
#   sudo $EDITOR /etc/kosaccounts.env
# Fill in the values below using the output of:
#   .venv/bin/python -m kosaccounts intake auth-setup
# Never commit this file with values filled in, and never paste values into the repo copy of
# this example. This file must stay out of git (see .gitignore: *.env, kosaccounts.env).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
